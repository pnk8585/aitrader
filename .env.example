# Alpaca credentials — get from https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Base URL — keep paper until ready for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional — NewsAPI.org key for supplemental news coverage (free tier: 100 req/day)
NEWS_API_KEY=

# Trading cycle interval in seconds (default: 300 = 5 minutes)
TRADING_CYCLE_SECONDS=300

# Position sizing
MAX_POSITION_PCT=0.02
MAX_SINGLE_TICKER_PCT=0.15

# Log directory
LOG_DIR=./logs
