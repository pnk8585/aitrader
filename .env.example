# Alpaca credentials — get from https://app.alpaca.markets → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Base URL — use paper for testing, live for real money
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading cycle interval in seconds
TRADING_CYCLE_SECONDS=60

# Position sizing (fractions of equity)
# MAX_POSITION_PCT    — max notional per trade (e.g. 0.50 = 50% of equity)
# MAX_SINGLE_TICKER_PCT — max total exposure per ticker (e.g. 0.80 = 80% of equity)
MAX_POSITION_PCT=0.50
MAX_SINGLE_TICKER_PCT=0.80

# Log directory
LOG_DIR=./logs

# Optional — NewsAPI.org key (free tier: 100 req/day). Leave blank to skip.
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Runner configuration — each stage runs independently via opencode or claude
# ---------------------------------------------------------------------------

# Stage 1 — news fetcher
NEWS_RUNNER=opencode          # opencode | claude
NEWS_MODEL=opencode/qwen3.6-plus-free

# Stage 2 — trading decisions + order execution
TRADER_RUNNER=opencode        # opencode | claude
TRADER_MODEL=opencode/kimi-k2.5

# Optional — aggressive trader overrides (used by ./run_aggressive.sh)
# Falls back to TRADER_RUNNER / TRADER_MODEL when unset.
AGGRESSIVE_TRADER_RUNNER=opencode   # opencode | claude
AGGRESSIVE_TRADER_MODEL=opencode/kimi-k2.5
AGGRESSIVE_TRADER_INTERVAL_SECONDS=300

# Optional — extreme momentum trader overrides (used by ./run_extreme.sh)
# Falls back to TRADER_RUNNER / TRADER_MODEL when unset.
# Extreme trader does NOT fetch news — pure momentum-based trading.
EXTREME_TRADER_RUNNER=opencode          # opencode | claude
EXTREME_TRADER_MODEL=zai-coding-plan/glm-5.1  # Fast, efficient for momentum scanning
EXTREME_TRADER_INTERVAL_SECONDS=60      # Fast rotation (1 minute)

# ---------------------------------------------------------------------------
# Common model IDs for reference
#
# opencode models (run `opencode models` for full list):
#   kimi-for-coding/k2p5              — fast, cheap
#   anthropic/claude-sonnet-4-6       — Claude Sonnet via opencode
#   anthropic/claude-opus-4-6         — Claude Opus via opencode
#
# claude models (set NEWS_RUNNER=claude or TRADER_RUNNER=claude):
#   claude-haiku-4-5                  — fastest, cheapest
#   claude-sonnet-4-6                 — balanced (recommended)
#   claude-opus-4-6                   — most capable
# ---------------------------------------------------------------------------
