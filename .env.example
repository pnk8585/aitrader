# ===== Kraken Exchange (crypto trading) =====
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_secret_here

# ===== Alpaca Exchange (stock trading) =====
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ===== AI (DeepSeek — used by AI Overseer for trading decisions) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== Database (PostgreSQL — used by all bots) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aitrader
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ===== News API (optional — for crypto news fetcher) =====
NEWSAPI_KEY=your_newsapi_key_here

# ===== Debug =====
# Set to true/1/yes to disable exception swallowing — stack traces propagate instead.
# DEBUG=true
