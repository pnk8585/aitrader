# Alpaca credentials — get from https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Base URL — keep paper until 5 days of reviewed logs
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional — NewsAPI.org key for supplemental news (free tier: 100 req/day)
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Runner configuration
# Each stage can run independently via "opencode" or "claude".
# ---------------------------------------------------------------------------

# Stage 1 — news fetcher
NEWS_RUNNER=opencode          # opencode | claude
NEWS_MODEL=kimi-for-coding/k2p5

# Stage 2 — trading decisions + order execution
TRADER_RUNNER=opencode        # opencode | claude
TRADER_MODEL=kimi-for-coding/k2p5

# ---------------------------------------------------------------------------
# Common model IDs for reference
#
# opencode models (run `opencode models` for full list):
#   kimi-for-coding/k2p5              — fast, cheap
#   anthropic/claude-haiku-4-5        — Claude Haiku via opencode
#   anthropic/claude-sonnet-4-6       — Claude Sonnet via opencode
#   anthropic/claude-opus-4-6         — Claude Opus via opencode
#
# claude models (NEWS_RUNNER=claude or TRADER_RUNNER=claude):
#   claude-haiku-4-5                  — fastest, cheapest Claude
#   claude-sonnet-4-6                 — balanced (recommended for trading)
#   claude-opus-4-6                   — most capable
#
# Example combos:
#   Both claude sonnet:
#     NEWS_RUNNER=claude  NEWS_MODEL=claude-sonnet-4-6
#     TRADER_RUNNER=claude  TRADER_MODEL=claude-sonnet-4-6
#
#   News cheap, trader capable:
#     NEWS_RUNNER=opencode  NEWS_MODEL=kimi-for-coding/k2p5
#     TRADER_RUNNER=claude  TRADER_MODEL=claude-sonnet-4-6
#
#   Both opencode (default):
#     NEWS_RUNNER=opencode  NEWS_MODEL=kimi-for-coding/k2p5
#     TRADER_RUNNER=opencode  TRADER_MODEL=kimi-for-coding/k2p5
# ---------------------------------------------------------------------------

# Aggressive mode: 60 second cycles
TRADING_CYCLE_SECONDS=60

# Log directory
LOG_DIR=./logs
